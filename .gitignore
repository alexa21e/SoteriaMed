# Data - everything except the frozen eval sets.
# Note `data/*`, not `data/`: with the trailing-slash form git will not descend
# into the directory and the negations below silently fail.
data/*
!data/eval_set_v*.jsonl
!data/.gitkeep

# Index / embedding artifacts anywhere outside data/
*.faiss

# Model checkpoints
*.ckpt
*.pt
*.pth
*.safetensors
models/

# Logs & outputs
*.log
logs/
outputs/
runs/
wandb/
mlruns/

# Secrets / env
.env
.env.*
!.env.example
*.key
secrets.json

# Organize work files and large output files
scratch/

# AI code review stuff
CLAUDE.md
.claude/
